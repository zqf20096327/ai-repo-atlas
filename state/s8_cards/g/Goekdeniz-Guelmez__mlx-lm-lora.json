 "identity": {
  "one_liner": "在 Apple Silicon 上用 MLX 本地微调大语言模型的训练库",
  "review": "基于 MLX 框架的 LLM 训练工具，面向在 Mac 上本地训练模型的开发者。主命令为 mlx_lm_lora.train，支持 LoRA/DoRA/全参数/量化（QLoRA 4/8-bit）训练与量化感知训练（QAT），训练算法覆盖 SFT、DPO、CPO、ORPO、GRPO、PPO 等十余种，兼容 MLX-LM 支持的全部模型（Llama、Mistral、Qwen、Gemma、OLMo 等）。通过命令行参数或 YAML 配置训练，数据采用 JSONL 格式，示例笔记本放在独立仓库。Apache 2.0 许可。",
  "highlights": [
   "支持 LoRA/DoRA/全参数/QLoRA 量化与 QAT 多种训练方式",
   "覆盖 SFT、DPO、ORPO、GRPO、PPO 等十余种训练算法",
   "兼容 MLX-LM 支持的全部模型（Llama/Mistral/Qwen/Gemma 等）",
   "提供 CLI 与 YAML 配置两种训练入口"
  ],
  "use_cases": [
   "在 Mac 上对开源 LLM 做 LoRA/DPO 偏好优化微调",
   "用 GRPO 等强化学习算法与自定义奖励函数训练模型",
   "通过 QAT 模拟量化效果以训练量化后的模型"
  ]
 },
