 "identity": {
  "one_liner": "面向 AI agent 开发的 Python 追踪调试器",
  "review": "Kolo 是一个基于文本的 Python 调试工具，用于追踪并可视化代码执行过程：捕获函数调用、返回值、局部变量、HTTP 请求等，写入可供人类与 agent 检索的纯文本 trace 文件。v3 将追踪数据以纯文本文件形式存储。主要面向使用 Django 等 Python 框架的开发者，通过 pip 安装并添加中间件即可在本地页面浏览追踪请求，查看 trace、SQL 查询与函数调用。提供文档站点与 Discord 社区。",
  "highlights": [
   "捕获函数调用、返回值、局部变量与 HTTP 请求",
   "trace 数据以纯文本文件存储，可供 grep 检索",
   "提供 Django 中间件，在 localhost:8000/_kolo/ 浏览追踪请求",
   "支持查看 SQL 查询与函数调用详情"
  ],
  "use_cases": [
   "调试 Django 请求的执行流程与 SQL 查询",
   "为 AI agent 提供可检索的代码执行 trace 文件",
   "可视化分析真实应用中的函数调用链"
  ]
 },
