 "identity": {
  "one_liner": "面向加速 MRI 重建的 PyTorch 深度学习工具包",
  "review": "DIRECT 是 NKI-AI（荷兰癌症研究所）维护的 PyTorch 工具包，处理加速磁共振成像重建全流程：读取欠采样多线圈 k-space 数据，提供采样掩码库（Cartesian/radial/spiral/Poisson 等）、十余种重建模型（vSHARP、RecurrentVarNet、RIM、VarNet、U-Net 等）、全监督/自监督 SSDU/JSSL 训练范式、分布式多 GPU 训练与 MRI 指标评估，经 direct train/predict 命令运行。预训练权重托管在 Hugging Face。声明不用于临床，Apache 2.0 许可。",
  "highlights": [
   "端到端流水线：采样、重建、可选配准、指标与预训练基线",
   "内置 vSHARP、RecurrentVarNet、RIM 等挑战赛获胜模型",
   "全监督 / SSDU / JSSL 训练范式，支持分布式多 GPU 与混合精度",
   "Hugging Face 模型库提供 .yaml/.pt 预训练权重，direct predict 直接推理"
  ],
  "use_cases": [
   "科研人员训练与评测 MRI 重建深度学习模型",
   "用预训练模型对欠采样 k-space 数据做重建推理",
   "复现 fastMRI、CMRxRecon 等挑战赛实验配置"
  ]
 },
