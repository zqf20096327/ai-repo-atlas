 "identity": {
  "one_liner": "预测合成语音自然度 MOS 的模型与 Python 库",
  "review": "UTokyo-SaruLab 的 MOS（平均意见分）预测系统官方实现，VoiceMOS Challenge 2024 Track1 T05 系统：从深度图像分类器迁移学习，对高质量合成语音预测自然度 MOS。提供预训练模型与 Python 库，可对张量、单个 wav 文件或目录批量预测 MOS，输出 float 或 CSV；另提供推理脚本、自训练指南与数据集文档。以 GitHub 源码安装（uv/pip），附 arXiv 论文与 Hugging Face Space 演示。",
  "highlights": [
   "预训练模型直接预测 MOS（Python API 与推理脚本两种方式）",
   "支持单个 wav、目录批量与内存张量三种输入，默认采样率 16000 Hz",
   "提供自行训练的指南与所使用数据集文档",
   "SLT 2024 论文发表，VoiceMOS Challenge 2024 Track1 参赛系统"
  ],
  "use_cases": [
   "评估语音合成系统的自然度而无需人工评分",
   "批量预测 wav 文件的 MOS 并导出 CSV",
   "在 Python 流水线中集成 MOS 预测做语音质量评测"
  ]
 },
