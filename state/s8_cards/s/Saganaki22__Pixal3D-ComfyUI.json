 "identity": {
  "one_liner": "ComfyUI 图生 3D 节点：本地运行 TencentARC Pixal3D 并导出带纹理 GLB",
  "review": "ComfyUI 自定义节点集合，封装 TencentARC/Pixal3D 模型在本地执行图像到 3D 生成，提供环境检查、模型加载、手动相机控制（FOV/距离/网格缩放）、带纹理 GLB 导出与模型卸载六个节点。要求 CUDA GPU（不支持纯 CPU），依赖 FlashAttention 2/3、多个 Pixal3D CUDA 内核 wheel 及 NATTEN（可选，缺失时可回退 DINO 投影特征）。Windows 提供预编译 wheel 安装路径与 VRAM 分级配置，模型权重需手动下载或自动下载。",
  "highlights": [
   "图像到 3D 生成并导出带纹理 .glb",
   "手动相机控制（FOV、距离、网格缩放）与 Scene/POV 预览",
   "NAF 缺失 CUDA NATTEN 时的回退模式与多档 VRAM 配置",
   "非方形输入自动补边为方形，避免拉伸"
  ],
  "use_cases": [
   "在 ComfyUI 工作流中从单张图片生成 3D 模型",
   "控制相机参数生成指定视角的 3D 资产",
   "导出可调面数与纹理尺寸的 GLB 供预览使用"
  ]
 },
