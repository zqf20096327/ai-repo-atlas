 "identity": {
  "one_liner": "Stable-Baselines3 的实验性强化学习算法扩展包",
  "review": "sb3-contrib 是 stable-baselines3 的 contrib 包，收录被认为实验性的 RL 算法与工具，如 ARS、QR-DQN、MaskablePPO、RecurrentPPO、TQC、TRPO、CrossQ 等，以及 Gym 的 Time Feature Wrapper。目标是保持 stable-baselines3 的简洁性、文档与代码风格，但容纳成熟度较低或较小众的实现，不要求与主库深度集成。通过 pip 安装，面向使用 PyTorch 与 Gym 的强化学习研究者与开发者。",
  "highlights": [
   "提供 ARS、QR-DQN、MaskablePPO、RecurrentPPO、TQC、TRPO、CrossQ 等实验性 RL 算法实现",
   "包含 Time Feature 等 Gym 环境包装器",
   "保持 stable-baselines3 的代码风格与文档标准",
   "支持 pip 安装 master 版本（git 源码）"
  ],
  "use_cases": [
   "在 SB3 生态中使用最新论文的实验性 RL 算法",
   "训练带无效动作掩码或循环策略的 PPO",
   "为 Gym 环境添加时间特征等包装器"
  ]
 },
