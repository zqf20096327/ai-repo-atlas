 "identity": {
  "one_liner": "基于 YOLOv7 与 SORT 的目标检测与追踪脚本工具",
  "review": "用 PyTorch、OpenCV 与 SORT 实现 YOLOv7 目标检测与多目标追踪的命令行工具：支持视频文件、摄像头、外接摄像头与 IP 摄像流作为输入，可按类别过滤检测、为每条轨迹分配颜色、保存轨迹中心点/ID/边界框坐标到 txt，并已加入 Ultralytics YOLOv8 权重支持（YOLOv9 及之后版本为计划中）。预训练权重可自动下载，输出保存在 runs/detect 目录。以源码仓库形式提供，含 Colab/Kaggle/SageMaker 运行入口。",
  "highlights": [
   "支持视频/摄像头/IP 摄像流输入的检测与追踪",
   "已支持 Ultralytics YOLOv8 权重（--weights yolov8n.pt）",
   "可保存轨迹 ID、中心点与边界框坐标，按类别过滤检测",
   "预训练 yolov7 权重可自动下载"
  ],
  "use_cases": [
   "对监控或视频流做带 ID 的多目标追踪",
   "只检测或只追踪特定类别（如行人）",
   "导出轨迹坐标数据用于后续分析"
  ]
 },
