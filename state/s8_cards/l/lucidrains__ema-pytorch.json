 "identity": {
  "one_liner": "PyTorch 模型指数移动平均（EMA）追踪库",
  "review": "为 PyTorch 模型维护指数移动平均（EMA）副本的 Python 库：在训练过程中更新 EMA 参数，支持 Karras 等人提出的 post-hoc 合成 EMA（PostHocEMA）、Switch EMA 的周期性模型更新选项，以及面向嵌套模块树的目标表示路由（EMAModuleWrapper），可把 EMA 子模块输出注入在线子模块的 forward 关键字参数，适配自监督学习（含多视图 SSL 的 student/teacher 输入）。通过 pip 安装，供深度学习模型训练使用。",
  "highlights": [
   "训练中维护模型 EMA 副本并可调用 EMA 模型",
   "PostHocEMA 实现 Karras 等人的事后合成 EMA",
   "Switch EMA 选项（update_model_with_ema_every）",
   "EMAModuleWrapper 支持嵌套模块树的目标表示路由与多视图 SSL"
  ],
  "use_cases": [
   "训练扩散模型等深度网络时维护 EMA 权重",
   "自监督学习中将 teacher（EMA）输出传递给 student 子模块",
   "复现论文中的 post-hoc EMA 与 Switch EMA 实验"
  ]
 },
