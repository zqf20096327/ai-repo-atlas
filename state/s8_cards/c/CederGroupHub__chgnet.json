 "identity": {
  "one_liner": "带电荷推断的通用神经网络势，用于原子级材料模拟",
  "review": "CHGNet 是在 Materials Project 超过 150 万结构（146k 化合物）的 GGA/GGA+U DFT 轨迹上预训练的图神经网络势，可直接预测给定结构的能量、力、应力和磁矩，支持电荷与磁性推断，精度接近 DFT。面向计算材料科研人员，提供分子动力学（经 ASE 或 LAMMPS）、结构优化、微调训练等流程，多版本预训练权重可选。README 声明新实现已迁移至 MatGL 仓库，本仓库作为遗留实现仅限关键缺陷修复。",
  "highlights": [
   "预测能量/力/应力/磁矩，经 DFT 磁矩正则化实现电荷推断",
   "在 150 万+ 结构的 MPtrj 数据集上预训练，覆盖全元素周期表",
   "支持分子动力学（ASE/LAMMPS）、结构优化与自定义数据微调",
   "运行于 CPU、CUDA、Intel XPU、Apple MPS 并自动选择设备"
  ],
  "use_cases": [
   "用预训练模型快速预测晶体结构性质，替代高成本 DFT 计算",
   "运行电荷感知的分子动力学模拟并输出轨迹与磁矩",
   "对特定体系微调以获得更高精度的势函数"
  ]
 },
